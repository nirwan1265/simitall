      "id": "pedigree_inbreeding",
      "family": "pedigree",
      "action": "simulate_and_analyze",
      "aliases": [
        "inbreeding",
        "inbred",
        "consanguinity",
        "first cousin mating",
        "selfing",
        "sib mating",
        "pedigree inbreeding coefficient"
      ],
      "implementation_status": "planned",
      "planner_status": "not_connected",
      "package_functions": [],
      "parameters": {
        "organism": {
          "type": "identifier",
          "required": true,
          "default_policy": "must_match_user_request"
        },
        "assembly": {
          "type": "identifier",
          "required_when": "real genomic inputs or genome coordinates are requested",
          "default_policy": "ask"
        },
        "region": {
          "type": "genomic_region",
          "required_when": "region-specific output is requested",
          "default_policy": "ask"
        },
        "mating_scheme": {
          "type": "enum",
          "allowed": [
            "selfing",
            "sib_mating",
            "first_cousin",
            "second_cousin",
            "custom_pedigree"
          ],
          "required": true,
          "default_policy": "ask"
        },
        "generations": {
          "type": "integer",
          "minimum": 1,
          "required": true,
          "default_policy": "ask"
        },
        "population_size": {
          "type": "integer",
          "minimum": 2,
          "required": true,
          "default_policy": "ask"
        },
        "marker_count": {
          "type": "integer",
          "minimum": 20,
          "required_when": "synthetic markers are used",
          "default_policy": "disclosed_default"
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "required": false,
          "default_policy": "automatic"
        }
      },
      "required_inputs": [
        "organism",
        "data source",
        "mating scheme or custom pedigree",
        "number of generations",
        "population size"
      ],
      "optional_inputs": [
        "phased founder genotypes",
        "recombination map",
        "reference assembly",
        "seed"
      ],
      "clarification_questions": [
        "Which inbreeding mechanism is intended: selfing, sibling mating, cousin mating, or a custom pedigree?",
        "Does \u201cgeneration\u201d mean a biological generation or a repeated mating cycle?",
        "How many individuals or families should be simulated per generation?"
      ],
      "recommended_results": [
        "pedigree table",
        "pedigree-based inbreeding coefficient by generation",
        "marker homozygosity by generation",
        "marker-based inbreeding estimate"
      ],
      "recommended_figures": [
        "pedigree diagram",
        "inbreeding coefficient by generation",
        "marker homozygosity by generation"
      ],
      "recommended_checks": [
        "pedigree has no cycles or unknown parent identifiers",
        "F values are finite and non-negative",
        "declared mating scheme matches generated pedigree"
      ],
      "guardrails": [
        "Inbreeding is a concept, not one mating scheme; do not map it automatically to selfing or first-cousin mating.",
        "Do not conflate pedigree F, marker homozygosity, and ROH-based measures.",
        "A generic synthetic model must not be labelled as real human chromosome data or clinical risk."
      ],
      "knowledge_sources": [
        "validation_contracts/human_pedigree_liability.Rmd"
      ],
      "paper_sources": [
        "papers/peng_2005_simupop.Rmd"
      ]
    },

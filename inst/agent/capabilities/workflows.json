{
  "registry_version": "1.0.0",
  "description": "Audited capability inventory and planning groundwork, not an executable workflow router.",
  "planner_integration": "not_connected",
  "default_policy": [
    "Never infer a real population or biological model from a synthetic demo.",
    "Ask for missing biological choices that change the scientific question.",
    "Only use documented implementation defaults and disclose them."
  ],
  "input_modes": {
    "provided": "Use supplied inputs; never replace them with synthetic data silently.",
    "synthetic": "Synthetic data only when requested or explicitly selected.",
    "package_demo": "Use bundled demonstration data only and disclose scope.",
    "ask": "Ask for inputs or scientifically consequential missing choices."
  },
  "status_definitions": {
    "partial": "Some named package functions exist; end-to-end support depends on the request and is not guaranteed.",
    "planned": "No end-to-end implementation is asserted."
  },

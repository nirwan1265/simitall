{
  "_about": "Biodes hand-off contract as read by Simitall and Bioana. Source of truth: github.com/nirwan1265/BioDesignGPT docs/SUITE_INTEGRATION.md and inst/registry/study_spec.schema.json. Add versions here when Biodes bumps handoff_version; never remove one.",
  "supported_handoff_versions": [
    "0.4"
  ],
  "required_files": [
    "study_spec.json",
    "field_layout.csv",
    "sample_metadata_template.tsv"
  ],
  "optional_files": [
    "unit_audit.json",
    "power_sensitivity.tsv"
  ],
  "written_by_simitall": [
    "sample_metadata_template.tsv",
    "counts.tsv",
    "sim_truth.json"
  ],
  "written_by_bioana": [
    "results.tsv",
    "fit_summary.json",
    "recovery.tsv",
    "de_results.tsv"
  ],
  "unsupported_model_tokens": [
    "spatial terms",
    "f(",
    "Toeplitz",
    "coxme",
    "Surv(",
    "FA(",
    "GCA_",
    "SCA_",
    "cor(",
    "BLUP_",
    "QTL",
    "SNP",
    "footprints",
    "eQTL",
    "per organism",
    ";"
  ],
  "count_assays": [
    "rnaseq",
    "rna-seq",
    "bulk_rnaseq",
    "rna_seq",
    "mrna-seq",
    "3' tag-seq",
    "quantseq"
  ]
}
